{
  "name": "@systemfsoftware/api-extractor",
  "version": "0.1.1",
  "description": "Effect-aware public-API model, diff and semver verdict for TypeScript packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/api-extractor-effect.git",
    "directory": "packages/api-extractor"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown -l warn",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; effect-tsgo oxlint . --format=${f:-default}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "attw": "attw --pack . --profile esm-only",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@microsoft/tsdoc": "catalog:",
    "@systemfsoftware/effect-cell-types": "^12.1.4",
    "oxc-parser": "catalog:",
    "oxc-transform": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "^8.1.4",
    "@systemfsoftware/effect-schema-law": "^6.1.5",
    "@systemfsoftware/effect-schema-vite": "^3.1.6",
    "@systemfsoftware/oxlint-config-recommended": "^6.0.1",
    "@systemfsoftware/stryker-config": "^0.2.1",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "^0.3.1",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "^0.1.3",
    "@systemfsoftware/stryker-js": "^22.0.0",
    "@systemfsoftware/stryker-js-typescript-checker": "^9.0.1",
    "@systemfsoftware/stryker-js-vitest-runner": "^10.1.0",
    "@systemfsoftware/tsconfig": "^2.1.0",
    "@systemfsoftware/tsdown-config": "^0.1.2",
    "@systemfsoftware/vitest": "^4.1.1",
    "@systemfsoftware/vitest-config": "^0.1.3",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.2"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "default": "./dist/mod.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
